# ── Sensitive credentials (never configurable from frontend) ──────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── Scraper defaults (overridable at runtime from frontend) ───────────────────
# These are only used to seed the DB on first run; UI values take precedence
DEFAULT_TARGET_ADDRESS=6 Av. Victor le Gorgeu, 29200 Brest, France
DEFAULT_MAX_PRICE=700
DEFAULT_MIN_SURFACE_M2=35
DEFAULT_MIN_ROOMS=2
DEFAULT_MAX_DRIVE_MINUTES=30
DEFAULT_MAX_WALK_MINUTES=45
DEFAULT_MAX_TRANSIT_MINUTES=30
DEFAULT_CRON_SCHEDULE=*/30 * * * *
