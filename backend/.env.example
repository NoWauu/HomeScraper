# ── Sensitive credentials ─────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# ── Transit routing (local Valhalla instance) ─────────────────────────────────
# Run: cd transit && ./setup.sh && docker compose up -d
VALHALLA_URL=http://localhost:8002

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── Scraper defaults (overridable from the frontend UI) ───────────────────────
DEFAULT_TARGET_ADDRESS=6 Av. Victor le Gorgeu, 29200 Brest, France
DEFAULT_MAX_PRICE=1500
DEFAULT_MIN_SURFACE_M2=25
DEFAULT_MIN_ROOMS=1
DEFAULT_MAX_DRIVE_MINUTES=30
DEFAULT_MAX_WALK_MINUTES=45
DEFAULT_MAX_TRANSIT_MINUTES=45
DEFAULT_CRON_SCHEDULE=*/30 * * * *
